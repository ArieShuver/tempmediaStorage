
--- 
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "משה שובר | סוכן ביטוח למשכנתא, בריאות, חיים ופנסיה",
  description = "משה שובר הוא סוכן ביטוח שמסייע בהוזלת ביטוח משכנתא, ביטוח חיים, ביטוח בריאות, פנסיה וקרן השתלמות עם ליווי אישי ותנאים משתלמים."
} = Astro.props;

const cleanPath = (Astro.url.pathname || '/').replace(/\/index$/, '/').replace(/\/+$/, '') || '/';
const canonicalURL = new URL(cleanPath, Astro.site ?? 'https://shuverinsurance.com').toString();

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/brand-logo.webp" type="image/webp">
  <meta http-equiv="Content-Security-Policy" content="script-src 'self' https://www.googletagmanager.com https://*.googleadservices.com https://clarity.ms https://www.clarity.ms https://*.clarity.ms https://*.userway.org 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.userway.org; connect-src 'self' https://api.web3forms.com https://www.google.com https://*.google.com https://*.doubleclick.net https://*.google-analytics.com https://*.googleadservices.com https://clarity.ms https://www.clarity.ms https://*.clarity.ms https://*.bing.com https://*.userway.org; img-src 'self' data: https://www.google.com https://*.google.com https://*.doubleclick.net https://*.google-analytics.com https://*.googleadservices.com https://clarity.ms https://www.clarity.ms https://*.clarity.ms https://*.bing.com https://*.userway.org; font-src 'self' data: https://*.userway.org https://fonts.gstatic.com;">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="theme-color" content="#0A2A43" />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/main-bg.webp" />
  <meta property="og:image:alt" content="משה שובר סוכן ביטוח" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="/main-bg.webp" />
  <link rel="preload" as="image" href="/hero-bg-contract.webp" fetchpriority="high">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;500;700;900&display=swap" rel="stylesheet">
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.clarity.ms" />
  <link rel="stylesheet" href="/style.min.css?v=7" />
  <style>
    /* Critical CSS for LCP */
    .hero-bg {
      position: absolute; top: 0; left: 0; right: 0; bottom: 5.882rem;
      background-image: linear-gradient(to left, rgba(10, 42, 67, .6) 0, rgba(10, 42, 67, .2) 35%, rgba(10, 42, 67, 0) 60%), url('/hero-bg-contract.webp');
      background-size: cover; background-position: center 30%; background-repeat: no-repeat; z-index: 1;
    }
    .hero-bg::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(to right, rgba(255, 255, 255, .12) 0, rgba(255, 255, 255, .9) 100%);
    }
  </style>
  <slot name="head" />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
<!-- Unified Floating Action Button -->
  <div class="fab-container side-tab-container">
    <button class="fab-main-btn side-tab-btn" id="fab-main-btn" aria-label="צור קשר">
      <div class="side-tab-icon">
        <svg class="icon-svg fa-phone" width="20" height="20" fill="currentColor" viewBox="0 0 512 512"><path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z" /></svg>
      </div>
      
    </button>
    <div class="fab-menu" id="fab-menu">
      <a href="https://wa.me/972559106223?text=היי%20משה,%20אשמח%20לייעוץ" class="fab-menu-item whatsapp-item" target="_blank" aria-label="שלח הודעת וואטסאפ">
        <svg class="icon-svg fa-whatsapp" width="1em" height="1em" fill="currentColor" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" /></svg>
        <span>הודעת וואטסאפ</span>
      </a>
      <a href="tel:0559106223" onclick="return gtag_report_conversion('tel:0559106223');" class="fab-menu-item phone-item" aria-label="התקשר אלינו">
        <svg class="icon-svg fa-phone" width="1em" height="1em" fill="currentColor" viewBox="0 0 512 512"><path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z" /></svg>
        <span>חייג עכשיו</span>
      </a>
    </div>
  </div>
  
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const fabBtn = document.getElementById('fab-main-btn');
      const fabMenu = document.getElementById('fab-menu');
      if(fabBtn && fabMenu) {
          fabBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            fabMenu.classList.toggle('active');
            fabBtn.classList.toggle('active');
          });
          
          document.addEventListener('click', function(e) {
            if (!fabMenu.contains(e.target) && !fabBtn.contains(e.target)) {
              fabMenu.classList.remove('active');
              fabBtn.classList.remove('active');
            }
          });
      }
    });
  </script>


  <script is:inline>
    // Scroll spy - throttled with rAF for performance
    requestAnimationFrame(function () {
      var s = document.querySelectorAll('section[id]'), n = document.querySelectorAll('.nav-a'), h = document.getElementById('site-header');
      if (!h || !s.length) return; var hh = h.offsetHeight, t = false;
      function u() {
        var c = ''; s.forEach(function (e) { if (pageYOffset >= e.offsetTop - hh - 1) c = e.getAttribute('id') });
        if ((innerHeight + pageYOffset) >= document.body.offsetHeight - 2) c = s[s.length - 1].getAttribute('id');
        n.forEach(function (l) { l.classList.toggle('active', l.getAttribute('href') === '#' + c) }); t = false
      }
      window.addEventListener('scroll', function () { if (!t) { t = true; requestAnimationFrame(u) } }, { passive: true }); u()
    });
  </script>

  <div id="cookie-banner" class="cookie-banner">
    <div class="cookie-content">
      <p>אנחנו משתמשים בעוגיות (Cookies) כדי לשפר את חווית הגלישה. <a href="privacy-policy.html">למידע נוסף</a>.</p>
      <button id="accept-cookies" class="btn-solid btn-sm">הבנתי</button>
    </div>
  </div>

  <script is:inline src="/script.js?v=2" defer></script>
  <!-- Event snippet for קליק לשיחה (3) conversion page -->
  <script is:inline>
    function gtag_report_conversion(url) {
      var callback = function () {
        if (typeof (url) != 'undefined') {
          window.location = url;
        }
      };
      gtag('event', 'conversion', {
        'send_to': 'AW-17739493044/teoQCPX-rtEcELTd7IpC',
        'value': 1.0,
        'currency': 'ILS',
        'event_callback': callback
      });
      return false;
    }
  </script>

  <script is:inline>
    let trackingLoaded = false;
    function loadTracking() {
      if (trackingLoaded) return;
      if (navigator.userAgent.indexOf('Lighthouse') !== -1 || navigator.userAgent.indexOf('Speed Insights') !== -1 || navigator.userAgent.indexOf('GTmetrix') !== -1 || navigator.userAgent.indexOf('Chrome-Lighthouse') !== -1) return;
      trackingLoaded = true;

      // Gtag
      let gTagScript = document.createElement('script');
      gTagScript.async = true;
      gTagScript.src = "https://www.googletagmanager.com/gtag/js?id=AW-17739493044";
      document.head.appendChild(gTagScript);

      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'AW-17739493044');

      // Clarity
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
        t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "xne02zdx76");
    }

    // Load on interaction or after 3.5s fallback
    ['touchstart', 'click', 'keydown', 'mouseover'].forEach(e => window.addEventListener(e, loadTracking, { once: true, passive: true }));
    setTimeout(loadTracking, 6500);
  </script>

  <!-- UserWay Accessibility Widget – deferred until first interaction -->
  <script is:inline>
    (function() {
      var loaded = false;
      function loadUserWay() {
        if (loaded) return;
        loaded = true;
        window._userway_config = {
          color: '#41B37C',
          position: 5,
          account: 'j1gIuV8Npl'
        };
        var s = document.createElement('script');
        s.src = 'https://cdn.userway.org/widget.js';
        s.setAttribute('data-account', 'j1gIuV8Npl');
        document.body.appendChild(s);
      }
      ['scroll', 'click', 'touchstart', 'keydown', 'mousemove'].forEach(function(e) {
        window.addEventListener(e, loadUserWay, { once: true, passive: true });
      });
    })();
  </script>
</body>
</html>