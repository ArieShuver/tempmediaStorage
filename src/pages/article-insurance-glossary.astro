  <!-- ===== INNER HERO ===== -->
  <section class="inner-hero" style="background: linear-gradient(rgba(10, 37, 64, 0.8), rgba(10, 37, 64, 0.9)), url('insurance_glossary.webp') center/cover no-repeat;">
    <div class="wrap inner-hero-content">
      <span class="highlight-text">מידע שימושי</span>
      <h1>מילון מונחי ביטוח: לדבר בגובה העיניים</h1>
      <p>חברות הביטוח מדברות ב"ביטוחית". אנחנו כאן כדי לתרגם לכם את כל המושגים המסובכים לעברית פשוטה ומובנת.</p>
    </div>
  </section>

  <!-- ===== ARTICLE CONTENT ===== -->
  <section class="article-section-enhanced">
    <div class="wrap">
      <div class="breadcrumb">
        <a href="index.html">דף הבית</a>
        <span class="sep">›</span>
        <a href="articles.html">מגזין ביטוח</a>
        <span class="sep">›</span>
        <span>מילון מונחי ביטוח</span>
      </div>
      <div class="article-layout">
      
      <!-- Main Content -->
      <main class="article-main">
        <div class="article-body fade-in-element">
          <p class="lead">הדוח השנתי של חברת הביטוח נראה לכם כמו סינית? הסוכן זורק מושגים כמו "ערך פדיון" ו"פרנצ'יזה" ואתם מהנהנים למרות שלא הבנתם מילה? אל תרגישו רע, שפת הביטוח אכן מסובכת. הכנו עבורכם מילון שימושי שיעזור לכם לקרוא את הדוחות ולהבין על מה אתם משלמים.</p>
          
          <div class="toc-box d-lg-none">
            <h4>במאמר זה:</h4>
            <ul>
              <li><a href="#general-terms">מונחי יסוד (פרמיה, פוליסה, חיתום)</a></li>
              <li><a href="#pension-terms">מונחי פנסיה וגמל</a></li>
              <li><a href="#health-terms">מונחי בריאות וסיעוד</a></li>
              <li><a href="#bottom-line">השורה התחתונה</a></li>
            </ul>
          </div>

          <h2 id="general-terms">מונחי יסוד בביטוח</h2>
          <ul>
            <li><strong>פוליסה:</strong> החוזה המשפטי ביניכם לבין חברת הביטוח. הפוליסה מפרטת בדיוק מה מכוסה, מה לא מכוסה, וכמה אתם משלמים.</li>
            <li><strong>פרמיה:</strong> התשלום החודשי או השנתי שאתם משלמים לחברת הביטוח בתמורה לכיסוי הביטוחי.</li>
            <li><strong>חיתום:</strong> תהליך הבדיקה שעושה חברת הביטוח לפני שהיא מקבלת אתכם. בחיתום רפואי יבדקו את עברכם הרפואי ויחליטו אם לקבל אתכם כרגיל, לייקר את הפרמיה (תוספת חיתומית), או להחריג מחלות קיימות.</li>
            <li><strong>החרגה (חריג):</strong> מצב ספציפי או מחלה שחברת הביטוח מציינת מראש שהיא <strong>לא</strong> תכסה בפוליסה שלכם.</li>
            <li><strong>מוטב:</strong> האדם או הגוף שאתם ממנים מראש לקבל את הכסף מהפוליסה במקרה של פטירתכם.</li>
          </ul>

          <h2 id="pension-terms">מונחי פנסיה, גמל וחיסכון</h2>
          <ul>
            <li><strong>ערך פדיון:</strong> הסכום במזומן שתוכלו לקבל ליד אם תחליטו לבטל את הפוליסה או הקופה ולמשוך את הכסף עכשיו (לרוב בניכוי קנסות או מס אם המשיכה נעשית שלא כדין).</li>
            <li><strong>ערך סילוק:</strong> מצב שבו הפסקתם לשלם פרמיות לפוליסה, אך לא משכתם את הכסף. הפוליסה הופכת ל"מסולקת" – הכסף ממשיך לצבור תשואה, אך הכיסויים הביטוחיים מתבטלים או קטנים בהתאם לכסף שנצבר.</li>
            <li><strong>מקדם המרה (מקדם פנסיה):</strong> המספר שבו מחלקים את סך כל הכסף שחסכתם ביום הפרישה, כדי לחשב את הקצבה החודשית שלכם. ככל שהמקדם נמוך יותר, הקצבה החודשית שתקבלו תהיה גבוהה יותר.</li>
            <li><strong>איזון אקטוארי:</strong> מנגנון בקרן פנסיה מקיפה שבו קרן הפנסיה מחלקת את העודפים או הגירעונות שלה בין כל החוסכים, בהתאם לתביעות ששולמו באותה שנה.</li>
          </ul>

          <h2 id="health-terms">מונחי בריאות וסיעוד</h2>
          <ul>
            <li><strong>תקופת אכשרה:</strong> תקופת זמן מתחילת הביטוח ועד לרגע שבו אתם זכאים באמת לתבוע. למשל, בביטוחי בריאות רבים יש תקופת אכשרה של 90 ימים שבמהלכה אינכם מכוסים (כדי למנוע מאנשים לקנות ביטוח רק כשהם כבר חולים).</li>
            <li><strong>תקופת המתנה:</strong> בביטוח סיעודי או אובדן כושר עבודה, זהו הזמן שעובר מרגע שחליתם ועד שחברת הביטוח מתחילה לשלם את הקצבה החודשית (לרוב 3 עד 6 חודשים).</li>
            <li><strong>פרנצ'יזה (פיצוי רטרואקטיבי):</strong> הרחבה לפוליסה שאומרת שאם עברתם את תקופת ההמתנה, חברת הביטוח תשלם לכם רטרואקטיבית גם על החודשים הראשונים שבהם המתנתם.</li>
            <li><strong>מבחן ADL:</strong> המבחן שקובע אם אדם הוא "סיעודי". בודק יכולת לבצע פעולות בסיסיות (לקום, לאכול, להתלבש, להתרחץ, לשלוט בסוגרים, להתנייד).</li>
          </ul>

          <div class="alert-box alert-warning">
            <h4 class="alert-title">האותיות הקטנות קובעות</h4>
            <p>חברת הביטוח פועלת על סמך הגדרות משפטיות מדויקות ולא על סמך הגיון בריא. אם הפוליסה מגדירה מחלה בצורה מסוימת, וחסר לכם תסמין אחד מההגדרה - התביעה עלולה להידחות. לכן חשוב לקרוא את התנאים עם איש מקצוע.</p>
          </div>

          <h2 id="bottom-line">השורה התחתונה</h2>
          <p>ידע הוא כוח, במיוחד כשמדובר בכסף ובבריאות שלכם. הכרת המונחים הבסיסיים תעזור לכם לשאול את השאלות הנכונות כשאתם רוכשים ביטוח, ותמנע מכם לחתום על פוליסות שאינן מתאימות לצרכים שלכם.</p>

          <div class="author-box-premium">
            <div class="author-img-wrap">
              <img src="brand-logo.webp" alt="משה שובר">
              <span class="author-badge">מחבר</span>
            </div>
            <div>
              <h4>נכתב ע"י משה שובר</h4>
              <p>סוכן ביטוח מורשה המאמין בשקיפות מלאה ובדיבור בגובה העיניים. אני כאן כדי לתרגם לכם את המושגים המסובכים ולהפוך את עולם הביטוח לנגיש וברור.</p>
            </div>
          </div>
          
