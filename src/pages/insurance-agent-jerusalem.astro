      "hasCredential": "סוכן ביטוח מורשה, מס' רישיון 00138633",
      "serviceType": ["ביטוח משכנתא", "ביטוח חיים", "ביטוח בריאות", "פנסיה", "קרן השתלמות", "קופת גמל להשקעה"]
    }
    </script>
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "האם אתם נפגשים עם לקוחות בירושלים פנים אל פנים?",
          "acceptedAnswer": { "@type": "Answer", "text": "כן. אפשר לקבוע פגישה פרונטלית בירושלים, ואפשר גם לנהל את כל התהליך טלפונית ודיגיטלית - לפי מה שנוח לכם." }
        },
        {
          "@type": "Question",
          "name": "כמה עולה שיחת הייעוץ הראשונה?",
          "acceptedAnswer": { "@type": "Answer", "text": "שיחת הייעוץ הראשונה היא ללא עלות וללא התחייבות. בשיחה נבין את הצרכים שלכם ונחליט יחד אם ואיך ממשיכים." }
        },
        {
          "@type": "Question",
          "name": "יש לי כבר ביטוחים. אפשר לבדוק אותם בלי לבטל משהו?",
          "acceptedAnswer": { "@type": "Answer", "text": "בוודאי. מבצעים בדיקה מקיפה של התיק הקיים, שומרים על הרצף הביטוחי ומשפרים רק את מה שמוזיל עלות או מרחיב כיסוי." }
        },
        {
          "@type": "Question",
          "name": "באילו אזורים בירושלים אתם פועלים?",
          "acceptedAnswer": { "@type": "Answer", "text": "בכל שכונות ירושלים והסביבה, ובמקביל גם ללקוחות בכל הארץ בליווי טלפוני ודיגיטלי." }
        },
        {
          "@type": "Question",
          "name": "איך המחירים שלכם נמוכים מההצעה שקיבלתי בבנק?",
          "acceptedAnswer": { "@type": "Answer", "text": "בזכות כוח קנייה קולקטיבי מול חברות הביטוח, אנחנו משיגים תנאים שאדם פרטי שניגש ישירות לחברה או לבנק בדרך כלל לא מקבל." }
