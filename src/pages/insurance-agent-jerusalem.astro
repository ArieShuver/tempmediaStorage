      "name": "משה שובר סוכן ביטוח",
      "image": "https://shuverinsurance.com/main-bg.webp",
      "url": "https://shuverinsurance.com/insurance-agent-jerusalem",
      "telephone": "+972559106223",
      "areaServed": { "@type": "City", "name": "ירושלים" },
      "geo": { "@type": "GeoCoordinates", "latitude": 31.7662075, "longitude": 35.1940129 },
