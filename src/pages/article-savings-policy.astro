          </div>

        </div>
      </main>

      <!-- Sticky TOC Sidebar -->
      <aside class="toc-sidebar d-none d-lg-block">
        <h3>ניווט מהיר</h3>
        <ol>
          <li><a href="#what-is-it" class="toc-link">מהי פוליסת חיסכון?</a></li>
          <li><a href="#liquidity" class="toc-link">נזילות וגמישות</a></li>
          <li><a href="#tax-deferral" class="toc-link">דחיית מס</a></li>
          <li><a href="#unlisted-assets" class="toc-link">נכסים בלתי סחירים</a></li>
          <li><a href="#bottom-line" class="toc-link">למי זה מתאים?</a></li>
        </ol>
      </aside>

      </div>
    </div>
  </section>

  <!-- ===== ARTICLE SCRIPTS ===== -->
  <script is:inline>
  (function() {
    // === Scroll Spy for TOC Sidebar ===
    var tocLinks = document.querySelectorAll('.toc-link');
    var sections = [];
    tocLinks.forEach(function(link) {
      var id = link.getAttribute('href').substring(1);
      var section = document.getElementById(id);
      if (section) sections.push({ el: section, link: link });
    });

    if (sections.length) {
      var spyThrottle = false;
      window.addEventListener('scroll', function() {
        if (spyThrottle) return;
        spyThrottle = true;
        setTimeout(function() { spyThrottle = false; }, 100);
        
        var scrollPos = window.scrollY + 200;
        var currentActive = null;
        
        sections.forEach(function(sec) {
          if (sec.el.offsetTop <= scrollPos) {
            currentActive = sec.link;
          }
        });
        
        if (currentActive) {
          tocLinks.forEach(function(l) { l.classList.remove('toc-active'); });
          currentActive.classList.add('toc-active');
        }
      });
    }

    // === Intersection Observer for Fade-In ===
    if ('IntersectionObserver' in window) {
      var faders = document.querySelectorAll('.fade-in-element');
      var observer = new IntersectionObserver(function(entries, obs) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, { rootMargin: "0px 0px -50px 0px" });
      faders.forEach(function(fader) { observer.observe(fader); });
    } else {
      document.querySelectorAll('.fade-in-element').forEach(function(el) { el.classList.add('is-visible'); });
    }
  })();
  </script>
</BaseLayout>
