---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="מגזין ביטוח ופיננסים | משה שובר סוכן ביטוח" description="מדריכים, מאמרים וטיפים לחסכון בביטוח משכנתא, ביטוח חיים, בריאות ופנסיה מאת משה שובר - סוכן ביטוח אישי.">
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "headline": "מגזין ביטוח ופיננסים",
    "description": "מאמרים וטיפים לחסכון בביטוחים.",
    "publisher": { "@type": "Organization", "name": "משה שובר סוכן ביטוח" },
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://shuverinsurance.com/articles.html" }
  }
  </script>
  </Fragment>

    <!-- ===== INNER HERO ===== -->
    <section class="inner-hero">
      <div class="inner-hero-bg"></div>
      <div class="wrap inner-hero-content">
        <span class="highlight-text">כל המדריכים והטיפים</span>
        <h1>מגזין ביטוח ופיננסים</h1>
        <p>כאן תמצאו מאמרים מקצועיים שיעזרו לכם לחסוך עשרות אלפי שקלים בביטוח משכנתא, חיים, בריאות ופנסיה.</p>
      </div>
    </section>

    <!-- ===== ARTICLES GRID ===== -->
    <section class="story-section article-section" style="padding-bottom: 60px;">
      <div class="wrap">
        
        <div style="margin-bottom: 20px; font-size: 0.95rem; color: var(--text-gray);">
          <a href="index.html" style="color: var(--primary);">דף הבית</a> &gt; מגזין ביטוח
        </div>

        <div class="blog-grid fade-in-element">
          <!-- Article Card -->
          <a href="article-bank-vs-agent.html" class="article-card">
            <div class="article-card-img-wrap">
              <img src="main-bg.webp" alt="ביטוח חיים דרך הבנק לעומת סוכן" loading="lazy">
            </div>
            <div class="article-card-content">
              <h3 class="article-card-title">ביטוח חיים למשכנתא: בנק מול סוכן פרטי - איפה תשלמו פחות?</h3>
              <p class="article-card-excerpt">גלו מדוע הצעת הביטוח של הבנק למשכנתאות תמיד תהיה יקרה יותר, ואיך מעבר לסוכן עצמאי יכול לחסוך לכם עשרות אלפי שקלים לאורך חיי המשכנתא.</p>
              <div class="article-card-read-more">קרא עוד <svg width="1em" height="1em" fill="currentColor" viewBox="0 0 448 512"><path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32L109.2 224 214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/></svg></div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ======== BOTTOM CTA ======== -->
    <section class="bottom-cta" id="contact">
      <div class="wrap">
        <div class="cta-box">
          <h2>לשיחת ייעוץ ללא עלות</h2>
          <p style="font-size: 1.3rem; margin-bottom: 30px; color: var(--primary-deep); max-width: 600px; margin-left: auto; margin-right: auto;">מלאו את הפרטים בלחיצה על הכפתור וגלו כיצד תוכלו לחסוך מאות ואלפי שקלים בביטוחים ובחסכונות שלכם.</p>
          <div style="margin-top: 40px; text-align: center;">
            <a href="index.html#contact" class="btn-solid btn-large" style="background: var(--green); font-size: 1.4rem; padding: 18px 45px; border-radius: 50px; box-shadow: 0 10px 30px rgba(65, 179, 124, 0.4); display: inline-flex; align-items: center; gap: 10px; transition: transform 0.3s ease;">
              <svg class="icon-svg fa-rocket fa-rocket" width="1em" height="1em" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--! Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2023 Fonticons, Inc. --><path d="M156.6 384.9L125.7 354c-8.5-8.5-11.5-20.8-7.7-32.2c3-8.9 7-20.5 11.8-33.8L24 288c-8.6 0-16.6-4.6-20.9-12.1s-4.2-16.7 .2-24.1l52.5-88.5c13-21.9 36.5-35.3 61.9-35.3l82.3 0c2.4-4 4.8-7.7 7.2-11.3C289.1-4.1 411.1-8.1 483.9 5.3c11.6 2.1 20.6 11.2 22.8 22.8c13.4 72.9 9.3 194.8-111.4 276.7c-3.5 2.4-7.3 4.8-11.3 7.2v82.3c0 25.4-13.4 49-35.3 61.9l-88.5 52.5c-7.4 4.4-16.6 4.5-24.1 .2s-12.1-12.2-12.1-20.9V380.8c-14.1 4.9-26.4 8.9-35.7 11.9c-11.2 3.6-23.4 .5-31.8-7.8zM384 168a40 40 0 1 0 0-80 40 40 0 1 0 0 80z"/></svg> תתחיל לחסוך עכשיו עם הטובים ביותר!
            </a>
            <div class="contact-phone-actions" style="margin-top: 25px; justify-content: center;">
              <span class="footer-tag" style="color: var(--text-gray); text-shadow: none;">או התקשרו ישירות:</span>
              <a href="tel:0559106223" onclick="return gtag_report_conversion('tel:0559106223');" class="contact-phone-link" style="color: var(--primary);">
                <svg class="icon-svg fa-phone fa-phone" width="1em" height="1em" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--! Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2023 Fonticons, Inc. --><path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z"/></svg> 055-9106223
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  
</BaseLayout>
