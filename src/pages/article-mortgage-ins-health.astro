---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
---
<BaseLayout title="ביטוח משכנתא למסורבי ביטוח ולחולים | משה שובר - סוכן ביטוח" description="מה עושים כשהבנק דורש ביטוח משכנתא אבל חברת הביטוח מסרבת לקבל אתכם עקב מצב רפואי? מדריך לפתרונות אפשריים והחרגות.">
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "ביטוח משכנתא לאנשים עם בעיות רפואיות",
      "description": "מה עושים כשהבנק דורש ביטוח משכנתא אבל חברת הביטוח מסרבת לקבל אתכם עקב מצב רפואי? מדריך לפתרונות אפשריים והחרגות.",
      "datePublished": "2026-09-27",
      "dateModified": "2026-09-27",
      "author": { "@type": "Person", "name": "משה שובר" },
      "publisher": { "@type": "Organization", "name": "משה שובר סוכן ביטוח" },
      "mainEntityOfPage": { "@type": "WebPage", "@id": "https://shuverinsurance.com/article-mortgage-ins-health" }
    }
    </script>
  </Fragment>

  <section class="inner-hero">
    <div class="inner-hero-bg"></div>
    <div class="wrap inner-hero-content">
      <span class="highlight-text">מאמר מקצועי</span>
      <h1>ביטוח משכנתא לאנשים עם בעיות רפואיות</h1>
      <p>מה עושים כשהבנק דורש ביטוח משכנתא אבל חברת הביטוח מסרבת לקבל אתכם עקב מצב רפואי? מדריך לפתרונות אפשריים והחרגות.</p>
    </div>
  </section>
  <section class="wrap content-section article-body text-layout">

        <div class="breadcrumb" style="margin-bottom: 2rem;">
          <a href="/">דף הבית</a>
          <span class="sep">›</span>
          <a href="/articles">מגזין ביטוח</a>
          <span class="sep">›</span>
          <span>ביטוח משכנתא לאנשים עם בעיות רפואיות</span>
        </div>
    
      <p>אחד התרחישים המלחיצים בתהליך רכישת דירה הוא סירוב של חברת הביטוח לבטח לווה עקב מצב רפואי, מה שעלול למנוע קבלת המשכנתא.</p>
      <h2>הפתרונות הקיימים</h2>
      <ul>
        <li><strong>פניה למספר חברות:</strong> לעיתים חברה אחת תסרב והשנייה תאשר בתוספת מחיר או בהחרגה. סוכן ביטוח עובד עם מספר חברות ויכול לעזור.</li>
        <li><strong>חוק ביטוח חיים למשכנתא למסורבים:</strong> קיימת מגבלה בחוק המאפשרת לאנשים עם תוחלת חיים מקוצרת לקבל ביטוח בתנאים מסוימים, או שהמדינה נותנת מענה הולם באמצעות פתרונות מיוחדים בחוק.</li>
        <li><strong>פטור מביטוח חיים לבן זוג אחד:</strong> לעיתים הבנק עשוי לאשר משכנתא אם רק בן הזוג הבריא מבוטח, תלוי ביחס ההחזר וההכנסות.</li>
      </ul>
      <p class="article-cta"><a href="/mortgage-insurance">קראו על כל פתרונות ביטוח המשכנתא</a></p>
    
  </section>

  <RelatedArticles articles={[
    { href: "/article-mortgage-life-insurance", title: "ביטוח חיים למשכנתא - כל מה שחייבים לדעת | משה שובר - סוכן ביטוח" },
    { href: "/article-mortgage-ins-vs-bank", title: "ביטוח משכנתא בבנק או דרך סוכן ביטוח? | משה שובר - סוכן ביטוח" },
    { href: "/article-health-declaration", title: "הצהרת בריאות בביטוח: למה אסור להסתיר מידע? | משה שובר" }
  ]} />
</BaseLayout>
