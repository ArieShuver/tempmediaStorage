---
import BaseLayout from '../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const cities = [
    { slug: 'jerusalem', name: 'ירושלים' },
    { slug: 'tel-aviv', name: 'תל אביב' },
    { slug: 'haifa', name: 'חיפה' },
    { slug: 'rishon-lezion', name: 'ראשון לציון' },
    { slug: 'petah-tikva', name: 'פתח תקווה' },
    { slug: 'ashdod', name: 'אשדוד' },
    { slug: 'netanya', name: 'נתניה' },
    { slug: 'beer-sheva', name: 'באר שבע' },
    { slug: 'holon', name: 'חולון' },
    { slug: 'ramat-gan', name: 'רמת גן' },
    { slug: 'bnei-brak', name: 'בני ברק' },
    { slug: 'bat-yam', name: 'בת ים' },
    { slug: 'rehovot', name: 'רחובות' },
    { slug: 'ashkelon', name: 'אשקלון' },
    { slug: 'herzliya', name: 'הרצליה' },
    { slug: 'kfar-saba', name: 'כפר סבא' },
    { slug: 'raanana', name: 'רעננה' },
    { slug: 'modiin', name: 'מודיעין' }
  ];

  return cities.map(city => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
---
<BaseLayout title={`מחפשים סוכן ביטוח ב${city.name}? | משה שובר - התאמה אישית`} description={`מחפשים סוכן ביטוח מקצועי ב${city.name}? משה שובר מציע ליווי אישי ופתרונות ביטוח, פנסיה ופיננסים מותאמים אישית לתושבי ${city.name} והסביבה. צרו קשר לייעוץ.`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`
    [
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "משה שובר - סוכן ביטוח",
        "image": "https://shuverinsurance.com/mosh_profile.webp",
        "url": "https://shuverinsurance.com/insurance-agent-${city.slug}",
        "telephone": "055-9106223",
        "areaServed": "${city.name}"
      }
    ]
    `}></script>
  </Fragment>

  <!-- ===== INNER HERO ===== -->
  <section class="inner-hero" style="background: linear-gradient(rgba(10, 37, 64, 0.8), rgba(10, 37, 64, 0.9)), url('/health_declaration.webp') center/cover no-repeat;">
    <div class="wrap inner-hero-content">
      <span class="highlight-text">שירות אישי, מקצועי ואמין</span>
      <h1 style="font-size: 4rem;">מחפשים סוכן ביטוח ב{city.name}?</h1>
      <p style="font-size: 1.4rem;">שירותי ביטוח, פנסיה ופיננסים בהתאמה אישית לתושבי {city.name} והסביבה.</p>
    </div>
  </section>

  <!-- ===== ARTICLE CONTENT ===== -->
  <section class="article-section-enhanced" style="background: var(--bg); padding: 60px 0;">
    <div class="wrap">
      <div class="breadcrumb" style="margin-bottom: 30px;">
        <a href="/index">דף הבית</a>
        <span class="sep">›</span>
        <a href="/articles">מאמרים ושירותים</a>
        <span class="sep">›</span>
        <span>סוכן ביטוח ב{city.name}</span>
      </div>

      <div class="story-content" style="background: var(--white); border-radius: 24px; padding: 50px; box-shadow: var(--shadow-md); margin-bottom: 60px; border: 1px solid var(--border);">
        <h2 style="font-size: 2.2rem; color: var(--primary); margin-bottom: 20px;">למה חשוב לבחור סוכן ביטוח מקצועי שמכיר אתכם?</h2>
        <p style="font-size: 1.2rem; color: var(--text-gray); line-height: 1.8;">
          בעולם בו רוב חברות הביטוח עוברות למוקדים טלפוניים ולמענה ממוחשב, הערך של סוכן ביטוח אישי שזמין עבורכם בזמן אמת אינו יסולא בפז. 
          כתושבי <strong>{city.name}</strong>, אתם זכאים לליווי צמוד, מקצועי ואישי, המותאם בדיוק לצרכים המיוחדים שלכם ושל משפחתכם.
        </p>
        <p style="font-size: 1.2rem; color: var(--text-gray); line-height: 1.8;">
          כאשר קורה מקרה ביטוחי חלילה, אתם לא רוצים להמתין על הקו לנציג שירות שלא מכיר אתכם. אתם רוצים את הסוכן שלכם, שידע להילחם עבורכם מול חברות הביטוח ולהשיג את המגיע לכם.
        </p>
      </div>

      <div class="centered" style="margin-bottom: 40px;">
        <h2 class="section-title">השירותים שלנו לתושבי {city.name}</h2>
      </div>

      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon">
            <svg width="40" height="40" fill="currentColor" viewBox="0 0 512 512"><path d="M256 0a256 256 0 1 1 0 512A256 256 0 1 1 256 0zM232 120V256c0 8 4 15.5 10.7 20l96 64c11 7.4 25.9 4.4 33.3-6.7s4.4-25.9-6.7-33.3L280 243.2V120c0-13.3-10.7-24-24-24s-24 10.7-24 24z"/></svg>
          </div>
          <h3>ביטוחי בריאות וסיעוד</h3>
          <p>התאמה אישית של פוליסות בריאות מתקדמות, כדי להבטיח מענה רפואי מהיר ופרטי במקרה הצורך.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg width="40" height="40" fill="currentColor" viewBox="0 0 512 512"><path d="M47.6 300.4L228.3 469.1c7.5 7 17.4 10.9 27.7 10.9s20.2-3.9 27.7-10.9L464.4 300.4c30.4-28.3 47.6-68 47.6-109.5v-5.8c0-69.9-50.5-129.5-119.4-141C347 36.5 300.6 51.4 268 84L256 96 244 84c-32.6-32.6-79-47.5-124.6-39.9C50.5 55.6 0 115.2 0 185.1v5.8c0 41.5 17.2 81.2 47.6 109.5z"/></svg>
          </div>
          <h3>ביטוחי חיים ומשכנתא</h3>
          <p>הגנה על עתיד המשפחה שלכם במחירים תחרותיים, תוך חיסכון משמעותי מול ההצעות של הבנקים.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg width="40" height="40" fill="currentColor" viewBox="0 0 512 512"><path d="M512 80c0 18-14.3 34.6-38.4 48c-29.1 16.1-72.5 27.5-122.3 30.9c-3.7-1.8-7.4-3.5-11.3-5C300.6 137.4 248.2 128 192 128c-8.3 0-16.4 .2-24.5 .6l-1.1-.6C142.3 114.6 128 98 128 80c0-44.2 86-80 192-80S512 35.8 512 80zM160.7 161.1c10.2-.7 20.7-1.1 31.3-1.1c62.2 0 117.4 12.3 152.5 31.4C369.3 204.9 384 221.7 384 240c0 4-.7 7.9-2.1 11.7c-4.6 13.2-17 25.3-35 35.5c0 0 0 0 0 0c-.1 .1-.3 .1-.4 .2l0 0c-20.3 11.4-46.2 21-75.1 27.5c-35.3 7.9-74 12.4-114.1 13.2C106.1 327.3 56.4 316 25.4 297.8C9.5 288.6 0 275.4 0 261.3c0-11 5.3-21.2 14.8-29.9c25.1-22.9 73.6-39.6 130-46.1c5.4-1.4 10.6-2.9 15.9-4.2zM218.4 380.6C176 385 129 388.9 79.5 390.8c-28.7 1.1-55.9 1.7-81.4 1.7L0 392.5V368c0-1.2 .1-2.4 .1-3.6C13.5 379.7 41.5 392 75.8 401.4c37.7 10.3 83.2 16.5 131.7 18.2c16.1 .6 32.5 .8 48.9 .8c1.6 0 3.2 0 4.8 0c4.1 0 8.1-.1 12.2-.1c-18.7-12-34.9-25.3-48-39.7h-.2c-2.4 0-4.8 0-7.2 0zM352 448c0 35.3-71.6 64-160 64c-81.6 0-149.1-24.9-158.8-57.5c24.6 3.6 51.5 6.7 80.3 8.9c23.6 1.8 48.3 3.1 73.9 3.7c1.6 .1 3.2 .1 4.9 .1c4.6 0 9.2 0 13.8 0c44 0 85.9-4 122.5-11.4c29.1-5.9 55.4-13.8 78-23.4c2.6-1.1 5.1-2.3 7.6-3.4c-.6 8.3-4.2 15.9-10 22.5c-13.1 14.8-35.1 27.5-62.2 36.6zM486.6 280.4c16.1-9 25.4-19.4 25.4-30.7c0-26.6-42.5-50-104-60.7c-3-6-6.4-11.8-10.2-17.2c69.8 11.2 114.2 41 114.2 77.9c0 14.5-9 28.5-25.4 40.7c-5.7 4.2-12 8.1-18.9 11.8c-1.3-7.5-3.3-14.8-5.9-21.8zM413 361.6c-4.9 13.2-12.7 25.6-22.7 36.8c12-3.1 23.4-6.8 34-11.1c16.4-6.6 30.5-14.5 41.5-23.4c17.6-14.2 26.2-29.3 26.2-44.1c0-12.5-6-24-16.7-34.4c-11.3-11-26.9-20.7-45.2-28.7c2.2 6.6 3.9 13.3 5 20.3c15.1 6.5 28 14 38 22.3c8.9 7.4 13.5 14.3 13.5 20.5c0 10-10.2 21-29.7 31.4c-12.3 6.6-27.1 12.6-43.9 17.5z"/></svg>
          </div>
          <h3>תכנון פנסיוני וגמל</h3>
          <p>בדיקה והוזלת דמי ניהול בקופות הגמל, קרנות ההשתלמות וקרנות הפנסיה שלכם, להגדלת החיסכון לגיל פרישה.</p>
        </div>
      </div>

      <div class="cta-box" style="margin-top: 60px;">
        <h2>זקוקים לייעוץ ביטוחי ב{city.name}?</h2>
        <p>אל תשאירו את העתיד שלכם ליד המקרה. צרו קשר עוד היום לפגישת ייעוץ ובדיקת תיק הביטוח שלכם ללא התחייבות.</p>
        <div class="contact-phone-actions" style="margin-top: 30px;">
          <a href="https://wa.me/972559106223?text=היי משה, הגעתי דרך האתר. אשמח לייעוץ ביטוחי." class="btn-solid" style="background: #25D366; text-decoration: none;">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 448 512" style="margin-left: 8px;"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.7 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
            שלחו הודעת וואטסאפ
          </a>
          <a href="tel:0559106223" class="btn-outline" style="text-decoration: none; padding: .706rem 1.647rem; font-weight: 700; border-radius: 30px; display: inline-flex; align-items: center;">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 512 512" style="margin-left: 8px;"><path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z"/></svg>
            חייגו: 055-9106223
          </a>
        </div>
      </div>

      {city.slug !== 'jerusalem' && (
        <div style="display: flex; justify-content: center; align-items: center; width: 100%; margin-top: 40px; font-size: 0.85rem; color: var(--text-gray); opacity: 0.75; padding: 0 20px;">
          <p style="margin: 0; text-align: center; max-width: 800px;">הבהרה משפטית: משה שובר סוכנות לביטוח מספקת שירותי ייעוץ וביטוח (באמצעות פגישות פרונטליות, טלפוניות ודיגיטליות) ללקוחות בכל רחבי הארץ, לרבות לתושבי {city.name} והסביבה. הסוכנות אינה מחזיקה בהכרח בסניף פיזי בעיר זו.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
