    <!-- ===== ARTICLE SCRIPTS ===== -->
    <script is:inline>
    (function() {

      // === Scroll Spy for TOC Sidebar ===
      var tocLinks = document.querySelectorAll('.toc-link');
      var sections = [];
      tocLinks.forEach(function(link) {
        var id = link.getAttribute('href').substring(1);
        var section = document.getElementById(id);
        if (section) sections.push({ el: section, link: link });
      });

      if (sections.length) {
        var spyThrottle = false;
        window.addEventListener('scroll', function() {
          if (spyThrottle) return;
          spyThrottle = true;
          requestAnimationFrame(function() {
            var scrollPos = window.pageYOffset + 120;
            var current = null;
            sections.forEach(function(s) {
              if (s.el.offsetTop <= scrollPos) current = s;
            });
            tocLinks.forEach(function(l) { l.classList.remove('toc-active'); });
            if (current) current.link.classList.add('toc-active');
            spyThrottle = false;
          });
        }, { passive: true });
      }

      // === FAQ Accordion ===
      document.querySelectorAll('.faq-accordion-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var item = this.closest('.faq-accordion-item');
          var content = item.querySelector('.faq-accordion-content');
          var inner = content.querySelector('.faq-accordion-content-inner');
          var isOpen = item.classList.contains('faq-open');

          // Close all others
          document.querySelectorAll('.faq-accordion-item.faq-open').forEach(function(openItem) {
            if (openItem !== item) {
              openItem.classList.remove('faq-open');
              openItem.querySelector('.faq-accordion-btn').setAttribute('aria-expanded', 'false');
              openItem.querySelector('.faq-accordion-content').style.maxHeight = '0';
            }
          });

          if (isOpen) {
            item.classList.remove('faq-open');
            this.setAttribute('aria-expanded', 'false');
            content.style.maxHeight = '0';
          } else {
            item.classList.add('faq-open');
            this.setAttribute('aria-expanded', 'true');
            content.style.maxHeight = inner.scrollHeight + 20 + 'px';
          }
        });
      });
    })();
    </script>

