import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="מה זה ביטוח ריסק? מושגי יסוד בביטוח חיים | משה שובר - סוכן ביטוח" description="מה משמעות המילה ריסק בעולם הביטוח, מה ההבדל בין ריסק טהור לחיסכון, ואיך מתאימים את הפוליסה הנכונה למשפחה שלכם.">
  <section class="inner-hero">
    <div class="inner-hero-bg"></div>
    <div class="wrap inner-hero-content">
      <span class="highlight-text">מאמר מקצועי</span>
      <h1>מה זה בעצם ביטוח ריסק (Risk)?</h1>
      <p>מה משמעות המילה ריסק בעולם הביטוח, מה ההבדל בין ריסק טהור לחיסכון, ואיך מתאימים את הפוליסה הנכונה למשפחה שלכם.</p>
    </div>
  </section>
  <section class="wrap content-section article-body text-layout">

        <div class="breadcrumb" style="margin-bottom: 2rem;">
          <a href="/index">דף הבית</a>
          <span class="sep">›</span>
          <a href="/articles">מגזין ביטוח</a>
          <span class="sep">›</span>
          <span>מה זה בעצם ביטוח ריסק (Risk)?</span>
        </div>
    
      <p>בעגה הביטוחית, כשאומרים "ריסק", מתכוונים לביטוח חיים טהור למקרה מוות בלבד. פוליסה זו אינה כוללת מרכיב של חיסכון.</p>
      <h2>ריסק טהור לעומת ביטוח מנהלים</h2>
      <p>בעבר היה נהוג לשלב ביטוח חיים יחד עם חיסכון (כמו בביטוחי מנהלים ישנים). היום הגישה המובילה היא הפרדה: ביטוח ריסק טהור בנפרד, וחיסכון (פנסיה, קופת גמל להשקעה) בנפרד.</p>
      <p>היתרון הגדול של ריסק טהור הוא העלות הנמוכה, שמאפשרת רכישת סכום כיסוי גבוה מאוד שיגן על המשפחה בעת צרה.</p>
      <p class="article-cta"><a href="/life-insurance">קראו עוד במדריך שלנו לביטוח חיים</a></p>
    
  </section>
</BaseLayout>
